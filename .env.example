# [에이전트] claude(기본값) 또는 codex
AGENT_PROVIDER=claude
# CLAUDE_PATH=claude
# CODEX_PATH=codex

# [플랫폼 토큰] Discord / Slack 중 최소 하나는 필수
DISCORD_BOT_TOKEN=your_discord_bot_token_here
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Verbose — 에이전트 및 MCP 서버 로그를 콘솔에 출력
VERBOSE=false

# Defaults
# DEFAULT_MODEL=  # 미지정 시 선택한 CLI 기본 모델 사용
# DEFAULT_REASONING_EFFORT=ultra  # Codex only; 모델이 지원하는 값
# DEFAULT_CWD=~/  # 미지정 시 현재 폴더(cwd) 사용
MAX_TURNS=50                # Claude Code only; 0 = unlimited
FETCH_MESSAGE_LIMIT=20      # 0 = max (500)
ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_CHANNEL_IDS=

# Claude: --dangerously-skip-permissions
# Codex: approvalPolicy=never + danger-full-access
# DANGEROUSLY_SKIP_PERMISSIONS=true

# Optional system prompt file
# SYSTEM_PROMPT_PATH=data/system-prompt.txt
